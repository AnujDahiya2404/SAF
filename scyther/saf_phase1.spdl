/*
 * SAF Phase 1: Pre-Session (Algorithm 1) -- Scyther SPDL model
 *
 * Reproduces the Stateful Authentication Framework's offline registration
 * phase from:
 *   Jamil, N. et al., "A Novel Stateful Authentication Framework Approach
 *   with LLM-based IDS for MQTT Security," IEEE IoT-J, 2026,
 *   DOI: 10.1109/JIOT.2025.3646115, Algorithm 1 / Fig. 2.
 *
 * Modeling notes:
 *  - The paper states Phase 1 is "conducted in a controlled, secure
 *    environment." We model that secure channel using standard
 *    public-key-secured messages ({...}pk(Role)), the usual Scyther
 *    idiom for "this exchange happens over an authenticated/confidential
 *    channel" (see e.g. IEEE-WIMAX/rsaplussatek*.spdl in the official
 *    Scyther protocol repository for the same idiom).
 *  - client_state = (session_time, estimated_duration) is abstracted as a
 *    single fresh Nonce `state` generated by the Broker (Algorithm 1,
 *    Step 3); x = h(state) is its SHA-256 hash (Step 4).
 *  - k is the 32-byte session key (Step 5); c is the initial counter.
 *  - Claims mirror Fig. 5 of the paper: Secret x, Secret y-components,
 *    Niagree, Nisynch, Alive, Weakagree, for both MQTTClient and
 *    MQTTBroker roles.
 */

hashfunction hash;
const ack;
usertype Ticket;

protocol SAFPhase1(Client, Broker)
{
    role Client
    {
        fresh requestTime: Nonce;
        var x: Ticket;
        var k, c: Nonce;

        // Message 1: client presents client_id (agent name Client) and
        // request_time, signed so the broker can verify it really
        // originates from this client (Algorithm 1, Step 1-2).
        send_1(Client, Broker, {Client, Broker, requestTime}sk(Client));

        // Message 2: broker's client-state establishment (Steps 3-6).
        // Signed with sk(Broker) for authenticity (client must know it is
        // really this broker), then encrypted under pk(Client) for
        // confidentiality (only this client can read x, k, c). This is
        // the standard Scyther "authenticated secure channel" idiom.
        recv_2(Broker, Client, {{Client, Broker, requestTime, x, k, c}sk(Broker)}pk(Client));

        // Message 3: client acknowledges by signing back a hash-commitment
        // of exactly what it received (Steps 7-8). Using hash(x,k,c)
        // rather than the raw values keeps k and x confidential (Scyther's
        // signature model allows message recovery from {m}sk(A), so
        // resending raw secrets here would leak them) while still binding
        // this ack to this specific broker run for agreement/synch claims.
        send_3(Client, Broker, {Client, Broker, requestTime, hash(x, k, c), ack}sk(Client));

        claim_c1(Client, Secret, x);
        claim_c2(Client, Secret, k);
        claim_c3(Client, Niagree);
        claim_c4(Client, Nisynch);
        claim_c5(Client, Alive);
        claim_c6(Client, Weakagree);
    }

    role Broker
    {
        var requestTime: Nonce;
        fresh state: Nonce;
        fresh k, c: Nonce;

        recv_1(Client, Broker, {Client, Broker, requestTime}sk(Client));
        send_2(Broker, Client, {{Client, Broker, requestTime, hash(state), k, c}sk(Broker)}pk(Client));
        recv_3(Client, Broker, {Client, Broker, requestTime, hash(hash(state), k, c), ack}sk(Client));

        claim_b1(Broker, Secret, hash(state));
        claim_b2(Broker, Secret, k);
        claim_b3(Broker, Niagree);
        claim_b4(Broker, Nisynch);
        claim_b5(Broker, Alive);
        claim_b6(Broker, Weakagree);
    }
}
